# Transactional email (Resend). Use an EU sending domain verified in Resend.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="Inner System Map <results@your-verified-domain.com>"
# Institute inbox that receives a copy of every emailed result (consent-gated). Leave empty to disable.
# In this repo, use a test inbox you own until launch; the real institute address goes in Vercel Production only.
RESULTS_COPY_TO=your_test_inbox@example.com

# WhatsApp Cloud API (optional; used only when WHATSAPP_RESULTS_READY is true in config/app.ts).
# System-user token from Meta Business Settings, with whatsapp_business_messaging permission.
WHATSAPP_TOKEN=your_whatsapp_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# Approved Utility template with a document header (default: inner_system_map_results)
WHATSAPP_TEMPLATE=inner_system_map_results

# Neon Postgres + Neon Auth (provisioned by the Vercel Marketplace; `npx vercel env pull .env.local` fills these)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
NEON_AUTH_BASE_URL=https://your-project.neonauth.example/neondb/auth
# 32+ random characters, signs session cookies. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=generate_a_long_random_string

# Public site URL for absolute links in social previews (optional; Vercel's production URL is used when unset)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Vercel Cron protection (Phase 7)
CRON_SECRET=generate_a_long_random_string
