# Transactional email (Resend). Use an EU sending domain verified in Resend.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="Inner System Map <results@your-verified-domain.com>"
# Institute inbox that receives a copy of every emailed result (consent-gated). Leave empty to disable.
RESULTS_COPY_TO=info@transcendentinstitute.com

# Neon Postgres + Neon Auth (provisioned by the Vercel Marketplace; `npx vercel env pull .env.local` fills these)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
NEON_AUTH_BASE_URL=https://your-project.neonauth.example/neondb/auth
# 32+ random characters, signs session cookies. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=generate_a_long_random_string

# Public site URL for absolute links in social previews (optional; Vercel's production URL is used when unset)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Vercel Cron protection (Phase 7)
CRON_SECRET=generate_a_long_random_string
