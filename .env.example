# Transactional email (Resend). Use an EU sending domain verified in Resend.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="Inner System Map <results@your-verified-domain.com>"
# Institute inbox that receives a copy of every emailed result (consent-gated). Leave empty to disable.
RESULTS_COPY_TO=info@transcendentinstitute.com

# Supabase (Phase 5)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Vercel Cron protection (Phase 7)
CRON_SECRET=generate_a_long_random_string
